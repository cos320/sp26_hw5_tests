/*
Will and Grace's test case
Computes the number of edits needed in order to change
one array into another 
(Edit is a swap, add, or delete of an entry)
*/

int editCount(int[] a, int n, int[] b, int m) {
  var dp = new int[(n+1) * (m+1)];

  for (var i = 0; i < n + 1; i = i + 1;) {
    dp[i] = i;
  }

  for (var i = 0; i < m + 1; i = i + 1;) {
    dp[i * (m+1)] = i;
  }

  for (var y = 1; y < m+1; y = y + 1;) {
    for (var x = 1; x < n + 1; x = x + 1;) {
      if (a[x-1] == b[y-1]) {
        dp[y * (n+1) + x] = dp[(y-1) * (n+1) + x - 1];
      } else {
        var min = dp[y * (n+1) + x - 1];
        if (min > dp[(y-1) * (n+1) + x]) {
          min = dp[(y-1) * (n+1) + x];
        }
        if (min > dp[(y-1) * (n+1) + x - 1]) {
          min = dp[(y-1) * (n+1) + x - 1];
        }
        min = min + 1;
        dp[y * (n+1) + x] = min;
      }
    }
  }

  return dp[(n+1) * (m+1) - 1];
}

int program(int argc, string[] argv) {
  var n = 10;
  var a = new int[]{
    6, 3, 2, 6, 4, 7, 2, 1, 3, 2
  };

  var m = 8;
  var b = new int[]{
    1, 2, 6, 7, 2, 9, 3, 2
  };

  var iters = 3000;
  var result = 0;
  for (var t = 0; t < iters; t = t + 1;) {
    result = editCount(a, n, b, m);
  }

  /* 2 deletes and 2 swaps */
  if (result == 4) {
    return 0;
  } else {
    return 1;
  }
}
