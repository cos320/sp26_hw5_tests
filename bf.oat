/* Raheem
BF interpreter running a quine
*/

int equal(string a, string b) {
    var array_a = array_of_string(a);
    var array_b = array_of_string(b);

    if (length(array_a) != length(array_b)) {
        return 0;
    } else {
        for (var i = 0; i < length(array_a); i = i + 1;) {
            if (array_a[i] != array_b[i]) {
                return 0;
            }
        }
    }
    return 1;
}

int mod(int val) {
    if (val > 255) {
        val = val - 256;
    } else if (val < 0) {
        val = val + 256;
    }
    return val;
}

string run_bf(string prog) {
    var output = "";
    var data = new int[5120];
    var ptr = 0;
    var input = array_of_string(prog);
    var i = 0;
    var depth = 0;
    while (i < length(input)) {
        if (input[i] == 62) {
           ptr = ptr + 1;
        } else if (input[i] == 60) {
           ptr = ptr - 1;
        } else if (input[i] == 43) {
           data[ptr] = mod(data[ptr] + 1);
        } else if (input[i] == 45) {
           data[ptr] = mod(data[ptr] - 1);
        } else if (input[i] == 46) {
           output = string_cat(output, string_of_array(new int[]{data[ptr]}));
        } else if (input[i] == 91) {
           if (data[ptr] == 0) {
                depth = 1;
                while (depth != 0) {
                    i = i + 1;
                    if (input[i] == 91) {
                        depth = depth + 1;
                    } else if (input[i] == 93) {
                        depth = depth - 1;
                    }
                }
            }
        } else if (input[i] == 93) {
            if (data[ptr] != 0) {
                depth = -1;
                while (depth != 0) {
                    i = i - 1;
                    if (input[i] == 91) {
                        depth = depth + 1;
                    } else if (input[i] == 93) {
                        depth = depth - 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    return output;
}

int program(int argc, string[] argv) {
    /* https://brainfuck.org/dquine.b */
    var dquine = ">+++++>+++>+++>+++++>+++>+++>+++++>++++++>+>++>+++>++++>++++>+++>+++>+++++>+>+>++++>+++++++>+>+++++>+>+>+++++>++++++>+++>+++>++>+>+>++++>++++++>++++>++++>+++>+++++>+++>+++>++++>++>+>+>+>+>++>++>++>+>+>++>+>+>++++++>++++++>+>+>++++++>++++++>+>+>+>+++++>++++++>+>+++++>+++>+++>++++>++>+>+>++>+>+>++>++>+>+>++>++>+>+>+>+>++>+>+>+>++++>++>++>+>+++++>++++++>+++>+++>+++>+++>+++>+++>++>+>+>+>+>++>+>+>++++>+++>+++>+++>+++++>+>+++++>++++++>+>+>+>++>+++>+++>+++++++>+++>++++>+>++>+>+++++++>++++++>+>+++++>++++++>+++>+++>++>++>++>++>++>++>+>++>++>++>++>++>++>++>++>++>+>++++>++>++>++>++>++>++>++>+++++>++++++>++++>+++>+++++>++++++>++++>+++>+++>++++>+>+>+>+>+++++>+++>+++++>++++++>+++>+++>+++>++>+>+>+>++++>++++[[>>>+<<<-]<]>>>>[<<[-]<[-]+++++++[>+++++++++>++++++<<-]>-.>+>[<.<<+>>>-]>]<<<[>>+>>>>+<<<<<<-]>++[>>>+>>>>++>>++>>+>>+[<<]>-]>>>-->>-->>+>>+++>>>>+[<<]<[[-[>>+<<-]>>]>.[>>]<<[[<+>-]<<]<<]";
    var iters = 100;
    var res = "";
    for (var i = 0; i < iters; i = i + 1;) {
        res = run_bf(dquine);
    }

    if (equal(res, dquine) == 1) {
        return 0;
    } else {
        return 1;
    }
}
