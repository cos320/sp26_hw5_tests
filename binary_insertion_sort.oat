/*
Arnav Ambre and John Wu's test case
Binary Insertion Sort
*/

global og = new int[]{5, 3923, 910, 34, 59820, 1, 12343, 0, 10, 251, 2, 4, 563, 21, 3};
global arr = new int[]{5, 3923, 910, 34, 59820, 1, 12343, 0, 10, 251, 2, 4, 563, 21, 3};

int binarySearch(int key, int low, int high) {
  while (low < high) {
    var offset = high - low;
    offset = offset >> 1;
    var mid = low + offset;

    if (arr[mid] <= key) {
      low = mid + 1;
    } else {
      high = mid;
    }
  }
  return low;
}

void binaryInsertionSort(int n) {
  var i = 1;
  while (i < n) {
    var key = arr[i];
    var pos = binarySearch(key, 0, i);

    var j = i;
    while (j > pos) {
      arr[j] = arr[j - 1];
      j = j - 1;
    }

    arr[pos] = key;
    i = i + 1;
  }
  return;
}

void copyArray(int n) {
  var i = 0;
  while (i < n) {
    arr[i] = og[i];
    i = i + 1;
  }
  return;
}

int program(int argc, string[] argv) {
  var n = 15;

  var t = 0;
  while (t < 200000) {
    copyArray(n);
    binaryInsertionSort(n);
    t = t + 1;
  }

  var j = 0;
  while (j < n) {
    print_int(arr[j]);
    j = j + 1;
  }

  return 0;
}