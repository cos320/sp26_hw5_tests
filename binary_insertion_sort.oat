global arr = new int[]{5, 3923, 910, 34, 59820, 1, 12343, 0, 10, 251, 2, 4, 563, 21, 3};

int binarySearch(int key, int low, int high) {
  while (low < high) {
    var offset = high - low;
    offset = offset >> 1;
    var mid = low + offset;

    if (arr[mid] <= key) {
      low = mid + 1;
    } else {
      high = mid;
    }
  }
  return low;
}

void binaryInsertionSort(int n) {
  var i = 1;
  while (i < n) {
    var key = arr[i];

    var pos = binarySearch(key, 0, i);

    var j = i;
    while (j > pos) {
      arr[j] = arr[j - 1];
      j = j - 1;
    }

    arr[pos] = key;
    i = i + 1;
  }
  return;
}

int program(int argc, string[] argv) {
  var n = 15;

  binaryInsertionSort(n);

  for (var j = 0; j < n; j = j+1;) {
    print_int(arr[j]);
  }

  return 0;
}